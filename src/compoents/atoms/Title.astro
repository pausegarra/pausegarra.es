---
interface Props {
  title: string;
  'as'?: 'h1' | 'h2' | 'h3' | 'h4';
  class?: string;
  transitionName?: string;
}
const { title, as: Tag = 'h2', class: additionalClass = '', transitionName } = Astro.props as Props;
const sizes = {
  h1: 'text-4xl md:text-6xl',
  h2: 'text-3xl md:text-4xl',
  h3: 'text-2xl',
  h4: 'text-sm',
};
---

<Tag class:list={['font-semibold', sizes[Tag], additionalClass]} transition:name={transitionName}>{title}</Tag>
