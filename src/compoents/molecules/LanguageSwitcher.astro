---
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales, type Locale } from "../../lib/i18n";

interface Props {
  currentLocale: Locale;
  routePath: string;
  label: string;
}

const { currentLocale, routePath, label } = Astro.props;
const currentLocaleData = locales.find((item) => item.code === currentLocale) ?? locales[0];
---

<details class="relative ml-auto shrink-0 language-switcher">
  <summary class="surface interactive flex cursor-pointer list-none items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-[var(--surface-hover)]">
    <span class="sr-only">{label}</span>
    <span aria-hidden="true" class="tracking-wide">{currentLocaleData.nativeLabel}</span>
    <span aria-hidden="true" class="text-muted">▾</span>
  </summary>

  <div class="absolute right-0 top-full z-20 mt-3 w-48 max-w-[calc(100vw-2rem)] rounded-xl border border-[var(--border)] bg-[var(--surface-raised)] p-2">
    {locales.map((locale) => (
      <a
        href={getRelativeLocaleUrl(locale.code, routePath)}
        data-locale={locale.code}
        aria-current={locale.code === currentLocale ? "true" : undefined}
        class:list={[
          "interactive flex items-center justify-between rounded-lg px-3 py-2 text-sm",
          locale.code === currentLocale
            ? "bg-[rgba(var(--accent),0.2)] text-white"
            : "text-muted hover:bg-[var(--surface-hover)] hover:text-white",
        ]}
      >
        <span>{locale.nativeLabel}</span>
        <span class="text-xs uppercase text-muted">{locale.code}</span>
      </a>
    ))}
  </div>
</details>

<script is:inline>
  const key = "pausegarra:locale";
  document.addEventListener("click", (event) => {
    const link = event.target instanceof Element ? event.target.closest("[data-locale]") : null;
    if (!link) return;

    try {
      localStorage.setItem(key, link.getAttribute("data-locale") || "");
    } catch {
      // Ignore storage failures.
    }
  });
</script>
