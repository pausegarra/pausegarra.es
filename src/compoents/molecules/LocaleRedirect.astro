---
import { getLocalizedPath } from "../../lib/browser-locale";
import { locales } from "../../lib/i18n";

const currentPath = Astro.url.pathname;
---

<main class="flex min-h-screen items-center justify-center bg-gray-950 px-4 text-center text-white">
  <div class="max-w-lg space-y-4 rounded-3xl border border-gray-800 bg-gray-900/70 p-8 shadow-2xl shadow-black/30">
    <p class="text-lg font-medium">Redirecting to the right language version.</p>
    <p class="text-sm text-gray-400">If nothing happens, choose a language below.</p>

    <div class="flex flex-wrap justify-center gap-3 pt-2">
      {locales.map((locale) => (
        <a
          href={getLocalizedPath(locale.code, currentPath)}
          class="rounded-full border border-gray-700 bg-gray-800 px-4 py-2 text-sm text-gray-100 transition hover:border-blue-400 hover:bg-gray-700"
        >
          {locale.nativeLabel}
        </a>
      ))}
    </div>
  </div>
</main>

<script>
  import { getPreferredLocalePath } from "../../lib/browser-locale";

  const target = getPreferredLocalePath(window.location.pathname);

  if (window.location.pathname !== target) {
    window.location.replace(target);
  }
</script>
