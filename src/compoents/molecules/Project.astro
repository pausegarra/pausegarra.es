---
import Card from "../atoms/Card.astro";
import Pill from "../atoms/Pill.astro";
import Title from "../atoms/Title.astro";

interface Props {
  project: {
    title: string;
    shortDescription: string;
    tech: string[];
    features: string[];
  };
  href: string;
  transitionKey: string;
  keyFeaturesLabel: string;
}

const {project, href, transitionKey, keyFeaturesLabel} = Astro.props;
---

<Card additionalClass="min-w-0 h-full flex-col p-6">
  <a href={href} aria-label={`View project ${project.title}`} class="interactive group block min-w-0 h-full rounded-lg">
    <Title as="h3" title={project.title} transitionName={`project-title-${transitionKey}`} class="interactive mb-4 break-words group-hover:text-[rgb(var(--accent-light))]" />
    <p class="mb-6 text-muted" transition:name={`project-description-${transitionKey}`}>{project.shortDescription}</p>
    <div class="mb-6">
      <h4 class="mb-3 text-sm font-semibold text-muted">{keyFeaturesLabel}</h4>
      <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2" aria-label={`Key features of ${project.title}`}>
        {project.features.map((feature) => (
          <li class="flex min-w-0 items-start gap-2 text-sm text-muted">
            <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[rgb(var(--accent))]"></span>
            <span class="min-w-0 break-words">{feature}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="flex flex-wrap gap-2">{project.tech.map((tech) => <Pill item={tech} />)}</div>
  </a>
</Card>
