---
import { Icon } from "astro-icon/components";

interface Props {
  link: string;
  title: string;
  icon: string;
}

const { link, title, icon } = Astro.props;
const isExternal = link.startsWith('http');
---

<a
  href={link}
  aria-label={`Contact via ${title}`}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="surface interactive flex min-w-0 items-center gap-4 rounded-xl p-4 hover:bg-[var(--surface-hover)]"
>
  <div class="shrink-0 text-2xl text-[rgb(var(--accent-light))]">
    {icon === 'material-symbols:alternate-email' ? <span aria-hidden="true">@</span> : <Icon name={icon} aria-hidden="true" />}
  </div>
  <h3 class="min-w-0 text-lg font-semibold">{title}</h3>
</a>
