---
import Title from "../atoms/Title.astro";
import Divider from "../atoms/Divider.astro";
import ContactCard from "../molecules/ContactCard.astro";

interface Props {
  copy: {
    title: string;
    description: string;
    cards: {
      email: string;
      linkedin: string;
      github: string;
    };
  };
}

const { copy } = Astro.props;
---

<section id="contact" class="site-section">
  <div class="site-container">
    <Title as="h2" title={copy.title} />
    <Divider />
    <p class="mt-6 max-w-2xl text-lg text-muted">{copy.description}</p>
    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      <ContactCard title={copy.cards.email} icon="material-symbols:alternate-email" link="mailto:pausegarra.b@gmail.com" />
      <ContactCard title={copy.cards.linkedin} icon="entypo-social:linkedin" link="https://www.linkedin.com/in/pausegarra/" />
      <ContactCard title={copy.cards.github} icon="entypo-social:github" link="https://github.com/pausegarra" />
    </div>
  </div>
</section>
