---
import Title from "../atoms/Title.astro";

interface Props {
  copy: {
    title: string;
    subtitle: string;
    description: string;
    primaryCta: string;
    secondaryCta: string;
  };
}

const { copy } = Astro.props;
---

<section class="site-section">
  <div class="site-container">
    <div class="max-w-[680px]">
      <Title class="hero-heading mb-6" title={copy.title} as="h1" />
      <h2 class="mb-6 text-2xl font-medium md:text-3xl">
        <span id="typing-target">{copy.subtitle}</span>
      </h2>
      <p class="mb-8 text-lg text-muted">{copy.description}</p>
      <div class="flex flex-wrap gap-4">
        <a href="#about" class="button button-primary interactive">{copy.primaryCta}</a>
        <a href="#contact" class="button button-secondary interactive">{copy.secondaryCta}</a>
      </div>
    </div>
  </div>
</section>
