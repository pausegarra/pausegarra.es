---
import { Icon } from 'astro-icon/components';
import Title from "../atoms/Title.astro";
import Divider from "../atoms/Divider.astro";

const skills = [
  { name: "Java", icon: "devicon:java" },
  { name: "Quarkus", icon: "devicon:quarkus" },
  { name: "Node.js", icon: "devicon:nodejs-wordmark" },
  { name: "PostgreSQL", icon: "devicon:postgresql" },
  { name: "MongoDB", icon: "devicon:mongodb-wordmark" },
  { name: "Docker", icon: "devicon:docker" },
  { name: "Kubernetes", icon: "devicon:kubernetes" },
  { name: "Express.js", icon: "devicon:express" },
  { name: "CI/CD", icon: "material-symbols:sync-alt" },
  { name: "Spring Boot", icon: "devicon:spring" },
  { name: "React.js", icon: "devicon:react" },
  { name: "Javascript", icon: "devicon:javascript" },
  { name: "TypeScript", icon: "devicon:typescript" },
  { name: "NestJS", icon: "devicon:nestjs" },
  { name: "Astro", icon: "devicon:astro" }
];
---

<section class="relative overflow-hidden bg-gray-900 px-4 py-20">
  <div class="pointer-events-none absolute -top-24 right-[-4rem] h-72 w-72 rounded-full bg-blue-500/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-28 left-[-5rem] h-80 w-80 rounded-full bg-green-500/10 blur-3xl"></div>

  <div class="relative mx-auto mb-12 max-w-6xl text-center sm:mb-16">
    <Title as="h2" title="Tech Stack" class="mb-2 bg-gradient-to-r from-blue-400 to-green-400" />
    <Divider class="bg-gradient-to-r from-blue-600 to-green-600" />
    <p class="mx-auto mt-5 max-w-2xl text-sm text-gray-400 sm:text-base">
      A compact snapshot of the tools I reach for most across backend, infrastructure, and product work.
    </p>
  </div>

  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5 sm:gap-4">
    {skills.map((skill) => (
      <div class="group flex items-center gap-3 rounded-2xl border border-gray-800/80 bg-gray-900/90 px-4 py-3 shadow-lg shadow-black/20 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/30 hover:bg-gray-900">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/5 bg-gradient-to-br from-blue-500/10 to-green-500/10 text-blue-300 transition-transform duration-300 group-hover:scale-105">
          <Icon name={skill.icon} class="text-2xl" />
        </div>
        <span class="text-left text-sm font-medium tracking-wide text-gray-200 transition-colors duration-300 group-hover:text-white">
          {skill.name}
        </span>
      </div>
    ))}
  </div>
</section>
