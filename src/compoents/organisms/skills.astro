---
import { Icon } from 'astro-icon/components';
import Title from "../atoms/Title.astro";
import Divider from "../atoms/Divider.astro";

interface Props {
  copy: {
    title: string;
    description: string;
  };
}

const { copy } = Astro.props;

const skills = [
  { name: "Java", icon: "devicon:java" },
  { name: "Quarkus", icon: "devicon:quarkus" },
  { name: "Node.js", icon: "devicon:nodejs-wordmark" },
  { name: "PostgreSQL", icon: "devicon:postgresql" },
  { name: "MongoDB", icon: "devicon:mongodb-wordmark" },
  { name: "Docker", icon: "devicon:docker" },
  { name: "Kubernetes", icon: "devicon:kubernetes" },
  { name: "Express.js", icon: "devicon:express" },
  { name: "CI/CD", icon: "material-symbols:sync-alt" },
  { name: "Spring Boot", icon: "devicon:spring" },
  { name: "React.js", icon: "devicon:react" },
  { name: "Javascript", icon: "devicon:javascript" },
  { name: "TypeScript", icon: "devicon:typescript" },
  { name: "NestJS", icon: "devicon:nestjs" },
  { name: "Astro", icon: "devicon:astro" }
];
---

<section class="site-section">
  <div class="site-container">
    <div class="mb-8 md:mb-12">
      <Title as="h2" title={copy.title} />
      <Divider />
      <p class="mt-6 max-w-2xl text-base text-muted">{copy.description}</p>
    </div>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
      {skills.map((skill) => (
        <div class="surface flex min-w-0 items-center gap-3 rounded-lg p-3">
          <div class="shrink-0 text-2xl">
            {skill.name === 'CI/CD' ? <span aria-hidden="true">↻</span> : <Icon name={skill.icon} aria-hidden="true" />}
          </div>
          <span class="min-w-0 text-sm font-medium">{skill.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
