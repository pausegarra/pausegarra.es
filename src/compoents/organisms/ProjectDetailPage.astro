---
import { getRelativeLocaleUrl } from "astro:i18n";
import { render, type CollectionEntry } from "astro:content";
import Title from "../atoms/Title.astro";
import Pill from "../atoms/Pill.astro";
import { siteUrl, type Locale, type SiteCopy } from "../../lib/i18n";
import { getProjectSlug } from "../../lib/projects";

interface Props {
  locale: Locale;
  project: CollectionEntry<"projects">;
  copy: SiteCopy["projectDetail"];
}

const { locale, project, copy } = Astro.props;
const { Content } = await render(project);
const projectSlug = getProjectSlug(project.slug);
---

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: project.data.title,
      description: project.data.shortDescription,
      url: `${siteUrl}/${locale}/projects/${projectSlug}/`,
      author: {
        '@type': 'Person',
        name: 'Pau Segarra',
        url: `${siteUrl}/`
      },
      about: project.data.tech
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: copy.breadcrumbs.home,
          item: `${siteUrl}/${locale}/`
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: copy.breadcrumbs.projects,
          item: `${siteUrl}/${locale}/projects/`
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: project.data.title,
          item: `${siteUrl}/${locale}/projects/${projectSlug}/`
        }
      ]
    }
  ]
})} />

<article class="site-container py-16 md:py-24">
  <nav aria-label={copy.breadcrumbs.projects} class="mb-8 text-sm text-muted">
    <ol class="flex flex-wrap items-center gap-3">
      <li><a class="interactive hover:text-white" href={getRelativeLocaleUrl(locale, '')}>{copy.breadcrumbs.home}</a></li>
      <li aria-hidden="true">/</li>
      <li><a class="interactive hover:text-white" href={getRelativeLocaleUrl(locale, 'projects')}>{copy.breadcrumbs.projects}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="min-w-0 break-words text-white">{project.data.title}</li>
    </ol>
  </nav>
  <div class="max-w-3xl">
    <Title as="h1" title={project.data.title} transitionName={`project-title-${locale}-${projectSlug}`} class="mb-6 break-words" />
    <p class="text-lg text-muted" transition:name={`project-description-${locale}-${projectSlug}`}>{project.data.shortDescription}</p>
  </div>
  <div class="my-8 flex flex-wrap gap-3">
    {project.data.links.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${copy.visitPrefix} ${link.title} ${project.data.title}`}
        class="button button-secondary interactive"
      >
        {copy.visitPrefix} {link.title}
      </a>
    ))}
  </div>
  <div class="prose prose-invert project-prose max-w-3xl"><Content /></div>
  <div class="mt-12 grid max-w-3xl grid-cols-1 gap-8 md:grid-cols-2">
    <section>
      <Title as="h2" title={copy.technologies} class="mb-4" />
      <div class="flex flex-wrap gap-2">{project.data.tech.map((tech) => <Pill item={tech} />)}</div>
    </section>
    <section>
      <Title as="h2" title={copy.features} class="mb-4" />
      <div class="flex flex-wrap gap-2">{project.data.features.map((feature) => <Pill item={feature} />)}</div>
    </section>
  </div>
</article>
