---
import Project from "../molecules/Project.astro";
import Title from "../atoms/Title.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { type Locale } from "../../lib/i18n";
import { getFeaturedProjectsForLocale, getProjectSlug } from "../../lib/projects";

interface Props {
  locale: Locale;
  copy: {
    title: string;
    button: string;
    keyFeatures: string;
  };
}

const { locale, copy } = Astro.props;
const projects = await getFeaturedProjectsForLocale(locale);
---

<section class="site-section">
  <div class="site-container">
    <div class="mb-8 md:mb-12">
      <Title transitionName="projects-title" as="h2" title={copy.title} />
      <div aria-hidden="true" transition:name="projects-divider" class="mt-4 h-1 w-12 rounded-full bg-[rgb(var(--accent))]"></div>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <Project
          project={project.data}
          href={getRelativeLocaleUrl(locale, `projects/${getProjectSlug(project.slug)}`)}
          transitionKey={`${locale}-${getProjectSlug(project.slug)}`}
          keyFeaturesLabel={copy.keyFeatures}
        />
      ))}
    </div>
    <a href={getRelativeLocaleUrl(locale, "projects")} class="button button-secondary interactive mt-8">{copy.button}</a>
  </div>
</section>
