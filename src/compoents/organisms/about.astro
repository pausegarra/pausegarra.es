---
import Title from "../atoms/Title.astro";
import Card from "../atoms/Card.astro";
import Divider from "../atoms/Divider.astro";

interface Props {
  copy: {
    title: string;
    paragraphs: readonly string[];
    stats: ReadonlyArray<{ value: string; label: string }>;
  };
}

const { copy } = Astro.props;
---

<section id="about" class="site-section">
  <div class="site-container">
    <div class="mb-8 md:mb-12">
      <Title as="h2" title={copy.title} />
      <Divider />
    </div>
    <div class="grid min-w-0 gap-8 md:grid-cols-[minmax(0,1fr)_16rem] md:items-start">
      <div class="min-w-0 space-y-6">
        {copy.paragraphs.map((paragraph) => (
          <p class="text-lg text-muted">{paragraph}</p>
        ))}
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {copy.stats.map((stat) => (
            <Card additionalClass="min-w-0 flex-col p-4">
              <div class="mb-2 text-3xl font-semibold">{stat.value}</div>
              <div class="text-sm text-muted">{stat.label}</div>
            </Card>
          ))}
        </div>
      </div>
      <img src="https://gravatar.com/avatar/63bfa48e51ec8bf6e6b92e4cb2867424?s=300&d=identicon" alt="Portrait of Pau Segarra" class="w-48 max-w-full rounded-xl md:w-64" />
    </div>
  </div>
</section>
