---
import Title from "../atoms/Title.astro";
import Card from "../atoms/Card.astro";
import Divider from "../atoms/Divider.astro";

interface Props {
  copy: {
    title: string;
    paragraphs: readonly string[];
    stats: ReadonlyArray<{ value: string; label: string }>;
  };
}

const { copy } = Astro.props;
---

<section id="about" class="py-20 px-4 bg-gray-800">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <Title as="h2" title={copy.title} class="mb-2 bg-gradient-to-r from-blue-400 to-green-400" />
      <Divider class="bg-gradient-to-r from-blue-600 to-green-600" />
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        {copy.paragraphs.map((paragraph) => (
          <p class="text-lg text-gray-300 leading-relaxed">{paragraph}</p>
        ))}

        <div class="grid grid-cols-2 gap-6 mt-8">
          {copy.stats.map((stat, index) => (
            <Card background="gray-900" additionalClass="flex-col p-4">
              <div class={`text-3xl font-bold ${index === 0 ? "text-blue-400" : "text-green-400"} mb-2`}>{stat.value}</div>
              <div class="text-gray-300">{stat.label}</div>
            </Card>
          ))}
        </div>
      </div>

      <div class="relative">
        <Card from="gray-700" to="gray-900" gradient additionalClass="w-full h-96 items-center justify-center">
          <div class="w-64 h-64 rounded-full mx-auto mb-4 flex items-center justify-center p-1 bg-gradient-to-br from-blue-500/80 to-green-400/80 shadow-2xl">
            <span class="text-4xl font-bold text-white rounded-full overflow-hidden">
              <img src="https://gravatar.com/avatar/63bfa48e51ec8bf6e6b92e4cb2867424?s=300&d=identicon" alt="Portrait of Pau Segarra" class="rounded-full"/>
            </span>
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>
