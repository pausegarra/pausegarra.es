---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import Title from "../atoms/Title.astro";
import Project from "../molecules/Project.astro";
import { type Locale, type SiteCopy } from "../../lib/i18n";
import { getProjectSlug } from "../../lib/projects";

interface Props {
  locale: Locale;
  copy: SiteCopy["projects"];
}

const { locale, copy } = Astro.props;
const projects = (await getCollection("projects")).filter((project) => project.slug.startsWith(`${locale}/`));
---

<div class="text-center my-16">
  <Title transitionName="projects-title" as="h1" title={copy.pageTitle} class="font-bold mb-2 bg-gradient-to-r from-green-400 to-blue-400 bg-clip-text text-transparent" />
  <div transition:name="projects-divider" class="w-24 h-1 bg-gradient-to-r from-green-600 to-blue-600 mx-auto"></div>
  <p class="mx-auto mt-6 max-w-2xl px-4 text-sm text-gray-400 sm:text-base">
    {copy.pageDescription}
  </p>
</div>

<div class="container mx-auto grid grid-cols-1 gap-6 px-4 pb-20 sm:grid-cols-2 md:grid-cols-3 md:px-0">
  {projects.map((project) => (
    <Project
      project={project.data}
      href={getRelativeLocaleUrl(locale, `projects/${getProjectSlug(project.slug)}`)}
      transitionKey={`${locale}-${getProjectSlug(project.slug)}`}
      keyFeaturesLabel={copy.keyFeatures}
    />
  ))}
</div>
