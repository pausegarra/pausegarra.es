---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import Title from "../atoms/Title.astro";
import Project from "../molecules/Project.astro";
import { type Locale, type SiteCopy } from "../../lib/i18n";
import { getProjectSlug } from "../../lib/projects";

interface Props {
  locale: Locale;
  copy: SiteCopy["projects"];
}

const { locale, copy } = Astro.props;
const projects = (await getCollection("projects")).filter((project) => project.slug.startsWith(`${locale}/`));
---

<div class="site-container pt-16 pb-12">
  <Title transitionName="projects-title" as="h1" title={copy.pageTitle} class="mb-4 break-words" />
  <div transition:name="projects-divider" aria-hidden="true" class="mt-4 h-1 w-12 rounded-full bg-[rgb(var(--accent))]"></div>
  <p class="mt-6 max-w-2xl text-base text-muted">
    {copy.pageDescription}
  </p>
</div>

<div class="site-container grid grid-cols-1 gap-6 pb-24 md:grid-cols-2">
  {projects.map((project) => (
    <Project
      project={project.data}
      href={getRelativeLocaleUrl(locale, `projects/${getProjectSlug(project.slug)}`)}
      transitionKey={`${locale}-${getProjectSlug(project.slug)}`}
      keyFeaturesLabel={copy.keyFeatures}
    />
  ))}
</div>
