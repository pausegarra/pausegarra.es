---
interface Props {
  copy: {
    developedBy: string;
    rights: string;
  };
}

const { copy } = Astro.props;
---

<footer class="py-8 text-muted">
  <div class="site-container flex flex-wrap items-center justify-between gap-4 text-sm">
    <p>{copy.developedBy} <span class="font-medium text-white">Pau Segarra</span></p>
    <p>&copy; {new Date().getFullYear()} Pau Segarra. {copy.rights}</p>
  </div>
</footer>
