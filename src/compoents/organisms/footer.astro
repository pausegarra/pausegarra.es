---
interface Props {
  copy: {
    developedBy: string;
    rights: string;
  };
}

const { copy } = Astro.props;
---

<footer class="bg-gray-950 text-gray-400 pt-12 pb-6 px-4 border-t border-gray-800">
  <div class="max-w-6xl mx-auto text-center space-y-4">
    <p class="text-sm">
      {copy.developedBy} <span class="text-white font-medium">Pau Segarra</span>
    </p>
    <p class="text-xs text-gray-500">&copy; {new Date().getFullYear()} Pau Segarra. {copy.rights}</p>
  </div>
</footer>
