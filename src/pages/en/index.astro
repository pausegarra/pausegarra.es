---
import HomePage from "../../compoents/organisms/HomePage.astro";
import Layout from "../../layouts/Layout.astro";
import { siteCopy, type Locale } from "../../lib/i18n";

const locale: Locale = "en";
const copy = siteCopy[locale];
---

<Layout
  title={copy.seo.homeTitle}
  description={copy.seo.homeDescription}
  locale={locale}
  routePath=""
  keywords={copy.seo.homeKeywords}
>
  <HomePage locale={locale} copy={copy} />
</Layout>
