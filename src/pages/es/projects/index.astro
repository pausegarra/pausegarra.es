---
import Layout from "../../../layouts/Layout.astro";
import ProjectsIndexPage from "../../../compoents/organisms/ProjectsIndexPage.astro";
import { siteCopy, type Locale } from "../../../lib/i18n";

const locale: Locale = "es";
const copy = siteCopy[locale];
---

<Layout
  title={copy.seo.projectsTitle}
  description={copy.seo.projectsDescription}
  locale={locale}
  routePath="projects"
  keywords={copy.seo.projectsKeywords}
>
  <ProjectsIndexPage locale={locale} copy={copy.projects} />
</Layout>
