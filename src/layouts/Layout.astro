---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from '../compoents/molecules/LanguageSwitcher.astro';
import { locales, siteCopy, siteUrl, getLocaleMeta, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routePath: string;
  ogImage?: string;
  keywords?: string;
}

const { title, description, locale, routePath, ogImage, keywords } = Astro.props;
const image = ogImage ? ogImage : '/favicon.svg';
const canonicalUrl = getAbsoluteLocaleUrl(locale, routePath);
const currentLocaleMeta = getLocaleMeta(locale);
const pageCopy = siteCopy[locale];
---

<!doctype html>
<html lang={currentLocaleMeta.htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Pau Segarra" />
  <meta name="theme-color" content="#181818" />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  {locales.map((item) => (
    <link rel="alternate" hreflang={item.code} href={getAbsoluteLocaleUrl(item.code, routePath)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("en", routePath)}>

  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={`${siteUrl}${image}`}>
  <meta property="og:site_name" content="Pau Segarra">
  <meta property="og:locale" content={currentLocaleMeta.ogLocale}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={`${siteUrl}${image}`}>
  <meta name="twitter:site" content="@pausegarra">
  <meta name="twitter:creator" content="@pausegarra">

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        url: `${siteUrl}/`,
        name: pageCopy.seo.homeTitle,
        inLanguage: locale,
        description: pageCopy.seo.homeDescription
      },
      {
        '@type': 'Person',
        '@id': `${siteUrl}/#person`,
        name: 'Pau Segarra',
        url: `${siteUrl}/`,
        jobTitle: 'Backend Software Engineer',
        description: description,
        sameAs: [
          'https://github.com/pausegarra',
          'https://www.linkedin.com/in/paausegarra'
        ]
      }
    ]
  })} />

  <title>{title}</title>
  <ClientRouter />
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
<header class="site-container flex flex-wrap items-center justify-between gap-4 py-6">
  <a href={getRelativeLocaleUrl(locale, '')} class="interactive shrink-0 font-semibold text-white">Pau Segarra</a>
  <nav class="flex min-w-0 flex-wrap items-center gap-4 text-sm" aria-label={pageCopy.navigation.home}>
    <a href={getRelativeLocaleUrl(locale, '')} aria-current={routePath === '' ? 'page' : undefined}
       class:list={['interactive rounded-lg px-3 py-2', routePath === '' ? 'text-[rgb(var(--accent-light))]' : 'text-muted hover:text-white']}>{pageCopy.navigation.home}</a>
    <a href={getRelativeLocaleUrl(locale, 'projects')} aria-current={routePath.startsWith('projects') ? 'page' : undefined}
       class:list={['interactive rounded-lg px-3 py-2', routePath.startsWith('projects') ? 'text-[rgb(var(--accent-light))]' : 'text-muted hover:text-white']}>{pageCopy.navigation.projects}</a>
    <a href={`${getRelativeLocaleUrl(locale, '')}#contact`} class="interactive rounded-lg px-3 py-2 text-muted hover:text-white">{pageCopy.navigation.contact}</a>
  </nav>
  <LanguageSwitcher currentLocale={locale} routePath={routePath} label={pageCopy.navigation.languageLabel} />
</header>
<main id="main-content">
  <slot />
</main>
</body>
</html>
